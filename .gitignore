# ==========================================
# TRISHULA - Git Ignore
# ==========================================

# Git
.git/

# ==========================================
# C++ / CMake build output
# ==========================================

backend/build/
backend/build_jenkins/
backend/build_*/
backend/CMakeFiles/
backend/CMakeCache.txt
backend/Makefile
backend/cmake_install.cmake
backend/install_manifest.txt
backend/*.exe
backend/*.dll
backend/*.o
backend/*.obj
backend/*.a
backend/*.lib

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# ==========================================
# Go
# ==========================================

*.exe
*.test
*.out

# ==========================================
# Node / Next.js
# ==========================================

mission-control-ui/node_modules/
mission-control-ui/.next/
mission-control-ui/out/
mission-control-ui/.vercel/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

*.pem
*.key
*.p12
*.pfx

# ==========================================
# IDE / Editors
# ==========================================

.vscode/
.idea/
*.swp
*.swo

# ==========================================
# OS files
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Logs
# ==========================================

*.log

# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.bak

# TypeScript generated build info
*.tsbuildinfo